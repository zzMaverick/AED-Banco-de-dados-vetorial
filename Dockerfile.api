FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ESTADO_DIR=/estado

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py api.py testes.py ./
COPY dados ./dados

EXPOSE 8000
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
